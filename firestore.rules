rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Open at the database level: the household password is checked by the
    // app, not by these rules. Fine for keeping two people's chores
    // straight, not a substitute for real security.

    match /households/{householdId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;

      match /profiles/{profileId} {
        allow read, write: if true;
      }
      match /tasks/{taskId} {
        allow read, write: if true;
      }
      match /log/{logId} {
        allow read, write: if true;
      }
      match /categories/{categoryId} {
        allow read, write: if true;
      }
      match /lists/{listId} {
        allow read, write: if true;
      }
    }
  }
}
